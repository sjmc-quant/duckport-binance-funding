# Historical start date
START_DATE=2024-01-01

# HTTP proxy URL (leave empty if not needed)
PROXY_URL=

# Optional status timeout override for data.watermark.
# Default is 32400 seconds (9h).
# WATERMARK_MAX_LAG_SECONDS=32400

# Run the hourly REST poll this many seconds after each hour boundary
FUNDING_POLL_DELAY_SECONDS=5

# Funding history requests are serial; sleep between adjacent requests
FUNDING_REQUEST_INTERVAL_SECONDS=0.2

# Sleep this many seconds between funding history retries
FUNDING_RETRY_SLEEP_SECONDS=75
