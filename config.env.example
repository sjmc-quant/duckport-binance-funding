# Data sources (comma-separated; currently supports usdt_perp_funding)
DATA_SOURCES=usdt_perp_funding

# Historical start date
START_DATE=2024-01-01

# Concurrency for REST, download, and WebSocket stream groups
CONCURRENCY=2

# Historical file download temporary directory
RESOURCE_PATH=/data/duckport/hist

# Parquet archive directory
PARQUET_DIR=/data/duckport/pqt

# HTTP/WebSocket proxy URL (leave empty if not needed)
PROXY_URL=

# Enable WebSocket mark-price collection
ENABLE_WS=true

# Batch flush interval for sampled pre-settlement WebSocket funding rows
WS_FLUSH_SECONDS=10

# Write one WS funding row per symbol when event time enters this many seconds before settlement
WS_SAMPLE_BEFORE_FUNDING_SECONDS=60

# REST overlap window for funding-rate catch-up
FUNDING_REST_BOUNDARY_DAYS=3
